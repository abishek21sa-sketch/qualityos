{
  "name": "qualityos",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "check": "node scripts/validate.mjs",
    "check:server": "node --check server.mjs && node --check db/postgres-store.mjs",
    "check:db": "node --check scripts/migrate-postgres.mjs",
    "db:migrate": "node scripts/migrate-postgres.mjs",
    "test:api": "node scripts/test-server.mjs",
    "test": "npm run check && npm run check:server && npm run check:db && npm run test:api",
    "start": "node server.mjs"
  },
  "dependencies": {
    "pg": "^8.13.1"
  },
  "engines": {
    "node": ">=20"
  }
}
